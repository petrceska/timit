{
  "manifest_version": 3,
  "name": "TimIt — Local Time Tracker",
  "version": "1.0.0",
  "description": "Offline time tracker with projects, reports and CSV import/export. All data stays on your computer.",
  "permissions": ["storage", "alarms", "activeTab", "scripting"],
  "action": {
    "default_title": "TimIt",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "offline_enabled": true,
  "commands": {
    "toggle-timer": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Start / stop the timer"
    }
  }
}
